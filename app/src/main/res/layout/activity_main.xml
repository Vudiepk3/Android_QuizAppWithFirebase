<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:id="@+id/row1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:text="@string/sologan"
                                android:textAlignment="center"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins_semibold"
                                android:textSize="24sp" />

                            <ImageView
                                android:id="@+id/logoImage"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_weight="1"
                                android:src="@drawable/image_logo"
                                android:contentDescription="@string/todo" />

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/slideCard"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_margin="10dp"
                            app:cardElevation="20dp"
                            app:cardCornerRadius="16dp"
                            android:padding="10dp">

                            <com.denzcoskun.imageslider.ImageSlider
                                android:id="@+id/ImageSlide"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:iss_auto_cycle="true"
                                app:iss_corner_radius="16"
                                app:iss_delay="2000"
                                app:iss_period="2000"
                                app:iss_title_background="@drawable/image_logo" />

                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/mathsCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@drawable/image_maths"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/literatureCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/englishCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"  />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/physicsCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/chemistryCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/biologyCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/historyCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/geographyCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.example.android_quizappwithfirebase.view.custom_view.SubjectCardView
                                android:id="@+id/civicEducationCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
